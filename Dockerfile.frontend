# ========================================
# Dockerfile pour Frontend Node.js/React
# Node 20 Alpine avec Vite build
# ========================================

FROM node:20-alpine AS builder

LABEL maintainer="esudelib-team"
LABEL description="Frontend React pour Système de Prédiction Master"

# Installation des dépendances système
RUN apk add --no-cache \
    python3 \
    make \
    g++

# Créer le répertoire de travail
WORKDIR /app

# Copier les fichiers de dépendances
COPY package*.json ./

# Installer les dépendances
RUN npm ci --only=production

# Copier le code source
COPY . .

# Build de production avec Vite
RUN npm run build

# ========================================
# Stage de production avec Nginx
# ========================================

FROM nginx:alpine

# Copier la configuration Nginx
COPY docker/nginx/nginx.conf /etc/nginx/nginx.conf
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf

# Copier les fichiers buildés depuis le stage builder
COPY --from=builder /app/public/build /usr/share/nginx/html

# Créer un utilisateur non-root
RUN addgroup -g 1000 -S www-data && \
    adduser -u 1000 -S www-data -G www-data && \
    chown -R www-data:www-data /usr/share/nginx/html && \
    chown -R www-data:www-data /var/cache/nginx && \
    chown -R www-data:www-data /var/log/nginx && \
    touch /var/run/nginx.pid && \
    chown -R www-data:www-data /var/run/nginx.pid

# Changer vers l'utilisateur non-root
USER www-data

# Exposer le port
EXPOSE 3000

# Healthcheck
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:3000/ || exit 1

# Démarrer Nginx
CMD ["nginx", "-g", "daemon off;"]
